<Window x:Class="Softkeys.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="softkeys"
        Width="900" Height="380"
        MinWidth="450" MinHeight="260"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowActivated="False"
        Focusable="False"
        WindowStartupLocation="CenterScreen">

    <!-- R-02: nothing in this window may ever take focus.
         Foregrounds are DynamicResource so the contrast switch (F-09) retints everything. -->
    <Window.Resources>
        <SolidColorBrush x:Key="KeyForeground" Color="White" />
        <SolidColorBrush x:Key="HeaderForeground" Color="#CCCCCC" />
        <Style TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource KeyForeground}" />
            <Setter Property="BorderBrush" Value="#66888888" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource HeaderForeground}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource HeaderForeground}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="6" Background="#E6000000">
        <DockPanel Margin="6">

            <!-- F-09 header bar: everything except ☰ and ✕ collapses behind the ☰ toggle -->
            <DockPanel x:Name="DragBar" DockPanel.Dock="Top" Height="32"
                       Background="Transparent"
                       MouseLeftButtonDown="OnDragBarMouseDown">
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Width="40"
                        Content="✕" BorderThickness="0" Click="OnCloseClick" />
                <Button x:Name="MinimizeButton" DockPanel.Dock="Right" Width="40"
                        Content="—" BorderThickness="0" Click="OnMinimizeClick" />
                <Button x:Name="MenuButton" DockPanel.Dock="Left" Width="40"
                        Content="☰" BorderThickness="0" Click="OnMenuToggle" />
                <TextBlock Text="softkeys" FontWeight="Bold" Margin="8,0,16,0" />
                <StackPanel x:Name="HeaderControls" Orientation="Horizontal" Visibility="Collapsed">
                    <CheckBox x:Name="CaptureToggle" Content="Hidden from capture"
                              Checked="OnCaptureToggleChanged" Unchecked="OnCaptureToggleChanged" />
                    <TextBlock Text="Color" Margin="24,0,8,0" />
                    <ComboBox x:Name="PaletteCombo" Width="110"
                              SelectionChanged="OnPaletteChanged" />
                    <TextBlock Text="Opacity" Margin="24,0,8,0" />
                    <Slider x:Name="OpacitySlider" Width="140"
                            Minimum="0" Maximum="1"
                            SmallChange="0.01" LargeChange="0.10"
                            ValueChanged="OnOpacityChanged" />
                    <TextBlock x:Name="OpacityLabel" Margin="8,0,0,0" Text="0.90" />
                </StackPanel>
            </DockPanel>

            <!-- F-04 + F-14: six rows, each an independent star grid built from
                 KeyMap in code (D-01, D-13). Star sizing gives proportional key
                 scaling on resize (F-11). -->
            <Grid x:Name="KeyGrid" />

        </DockPanel>
    </Border>

</Window>
