<Window x:Class="Softkeys.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="softkeys"
        Width="900" Height="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowActivated="False"
        Focusable="False"
        WindowStartupLocation="CenterScreen">

    <!-- R-02: nothing in this window may ever take focus -->
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#66FFFFFF" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="6" Background="#E6000000">
        <DockPanel Margin="6">

            <!-- Temporary M2/M3 control strip; becomes the collapsible header bar at M4 (F-09) -->
            <DockPanel x:Name="DragBar" DockPanel.Dock="Top" Height="32"
                       Background="Transparent"
                       MouseLeftButtonDown="OnDragBarMouseDown">
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Width="40"
                        Content="✕" BorderThickness="0" Click="OnCloseClick" />
                <TextBlock Text="softkeys" FontWeight="Bold" Margin="6,0,16,0" />
                <CheckBox x:Name="CaptureToggle" Content="Hidden from capture"
                          IsChecked="True"
                          Checked="OnCaptureToggleChanged" Unchecked="OnCaptureToggleChanged" />
                <TextBlock Text="Opacity" Margin="24,0,8,0" />
                <Slider x:Name="OpacitySlider" Width="140"
                        Minimum="0" Maximum="1"
                        SmallChange="0.01" LargeChange="0.10"
                        Value="0.90"
                        ValueChanged="OnOpacityChanged" />
                <TextBlock x:Name="OpacityLabel" Margin="8,0,0,0" Text="0.90" />
            </DockPanel>

            <!-- F-04: five rows, 30 star columns; populated from KeyMap in code (D-01) -->
            <Grid x:Name="KeyGrid" />

        </DockPanel>
    </Border>

</Window>
