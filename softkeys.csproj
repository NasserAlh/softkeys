<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe from M2 on: no console window for the keyboard itself.
         The selftest/harness modes reattach to the parent console in Program. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- D-17: single source of truth for the version; installer/build.ps1
         injects it into the Inno script so exe, Apps & Features, and release
         notes can never drift. -->
    <Version>1.3.0</Version>
    <!-- F-15: window/taskbar/Explorer icon; generated by assets\generate-icon.ps1 -->
    <ApplicationIcon>assets\softkeys.ico</ApplicationIcon>
    <UseWPF>true</UseWPF>
    <RootNamespace>Softkeys</RootNamespace>
    <AssemblyName>softkeys</AssemblyName>
    <StartupObject>Softkeys.Program</StartupObject>
    <!-- win-x64 only (NF-03); pinned so the D-08 struct assertions are deterministic -->
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- NF-06: per-monitor-v2 DPI awareness -->
    <ApplicationManifest>src\app.manifest</ApplicationManifest>
    <!-- NF-03: bundle WPF native libs so the §7 publish command yields ONE exe.
         Only takes effect when PublishSingleFile is set. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- tools/ holds standalone developer utilities (their own projects). The
         SDK's default **/*.cs glob would otherwise compile them into the app. -->
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />

    <!-- A4/D-28: the English completion dictionary, Brotli-compressed and
         embedded. LogicalName pins the resource id so the C# side never has to
         depend on RootNamespace vs AssemblyName. The blob is committed
         (precedent: assets/softkeys.ico) so a clone builds with no network and
         no corpus; regenerate it with tools/DictionaryBuilder. -->
    <EmbeddedResource Include="assets\softkeys-words.br" LogicalName="softkeys.words"
                      Condition="Exists('assets\softkeys-words.br')" />
  </ItemGroup>

</Project>
